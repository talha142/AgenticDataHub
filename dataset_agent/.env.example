# vLLM server configuration
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=token-abc123          # any string if no auth on your vLLM server
VLLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B

# Dataset output directory (absolute path)
OUTPUT_DIR=./output

# Scraper settings
MAX_SCRAPE_DEPTH=3                 # how many link-hops the scraper may follow
MAX_PAGES_PER_DOMAIN=20
REQUEST_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
